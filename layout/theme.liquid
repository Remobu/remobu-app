  </svg>
</a>
<div class="remobu-whatsapp-tooltip">Chat with us on WhatsApp</div>
<!-- Remobu Farm Advisor Widget -->
<style>
.remobu-advisor-btn{position:fixed;bottom:20px;left:20px;width:52px;height:52px;border-radius:50%;background:#2D5233;border:none;cursor:pointer;z-index:9999;padding:4px;box-shadow:0 2px 8px rgba(0,0,0,0.3);}
.remobu-advisor-btn img{width:100%;height:100%;border-radius:50%;object-fit:contain;background:white;}
.remobu-chat-panel{display:none;position:fixed;bottom:80px;left:20px;width:300px;height:480px;background:#F5F0E8;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.3);z-index:9999;flex-direction:column;overflow:hidden;}
.remobu-chat-panel.open{display:flex;}
.remobu-chat-header{background:#2D5233;padding:12px;display:flex;align-items:center;gap:10px;}
.remobu-chat-header img{width:36px;height:36px;border-radius:50%;background:white;padding:2px;object-fit:contain;}
.remobu-chat-header h3{color:#C9922A;margin:0;font-size:15px;}
.remobu-chat-header p{color:#F5F0E8;margin:0;font-size:11px;font-style:italic;}
.remobu-close-btn{margin-left:auto;background:none;border:none;color:#F5F0E8;font-size:20px;cursor:pointer;}
.remobu-chat-body{flex:1;padding:12px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;}
.remobu-message{background:white;border-radius:10px;padding:12px;border-left:3px solid #C9922A;font-size:13px;line-height:1.6;color:#333;}
.remobu-input-area{background:white;padding:10px;border-top:2px solid #2D5233;}
.remobu-input-area select{width:100%;padding:5px;margin-bottom:8px;border-radius:5px;border:1px solid #ccc;font-size:12px;color:#2D5233;}
.remobu-input-row{display:flex;gap:6px;}
.remobu-input-area textarea{flex:1;padding:7px;border-radius:5px;border:1px solid #ccc;font-size:12px;resize:none;font-family:inherit;}
.remobu-ask-btn{background:#2D5233;color:white;border:none;padding:7px 12px;border-radius:5px;cursor:pointer;font-weight:bold;font-size:12px;}
.remobu-ask-btn:disabled{background:#888;cursor:not-allowed;}
</style>

<button class="remobu-advisor-btn" onclick="document.querySelector('.remobu-chat-panel').classList.toggle('open')" aria-label="Open Farm Advisor">
  <img src="https://cdn.shopify.com/s/files/1/0975/4057/1438/files/Remobu_Logo.jpg?v=1778694454" alt="Remobu"/>
</button>

<div class="remobu-chat-panel">
  <div class="remobu-chat-header">
    <img src="https://cdn.shopify.com/s/files/1/0975/4057/1438/files/Remobu_Logo.jpg?v=1778694454" alt="Remobu"/>
    <div><h3>Remobu Farm Advisor</h3><p>we're the soil</p></div>
    <button class="remobu-close-btn" onclick="document.querySelector('.remobu-chat-panel').classList.remove('open')">✕</button>
  </div>
  <div class="remobu-chat-body" id="remobu-chat-body">
    <div class="remobu-message">👋 Hello! I'm your <strong>Remobu Farm Advisor</strong>. Ask me anything about farming, crops, soil health, or pests!</div>
  </div>
  <div class="remobu-input-area">
    <select id="remobu-lang">
      <option value="en">🇬🇧 English</option>
      <option value="st">🇱🇸 Sesotho</option>
    </select>
    <div class="remobu-input-row">
      <textarea id="remobu-question" rows="2" placeholder="Ask your farming question..."></textarea>
      <button class="remobu-ask-btn" id="remobu-ask-btn" onclick="remobAsk()">Ask</button>
    </div>
  </div>
</div>

<script>
function remobAsk() {
  const question = document.getElementById('remobu-question').value.trim();
  const language = document.getElementById('remobu-lang').value;
  const body = document.getElementById('remobu-chat-body');
  const btn = document.getElementById('remobu-ask-btn');
  if (!question) return;
  btn.disabled = true;
  btn.textContent = '...';
  const userMsg = document.createElement('div');
  userMsg.className = 'remobu-message';
  userMsg.style.background = '#e8f5e9';
  userMsg.style.borderLeft = '3px solid #2D5233';
  userMsg.innerHTML = '<strong style="color:#2D5233">👤 You</strong><br>' + question.replace(/\n/g,'<br>');
  body.appendChild(userMsg);
  body.scrollTop = body.scrollHeight;
  const thinkMsg = document.createElement('div');
  thinkMsg.className = 'remobu-message';
  thinkMsg.innerHTML = '<img src="https://cdn.shopify.com/s/files/1/0975/4057/1438/files/Remobu_Logo.jpg?v=1778694454" style="width:16px;height:16px;border-radius:50%;vertical-align:middle;margin-right:6px;"> Thinking...';
  thinkMsg.id = 'remobu-thinking';
  body.appendChild(thinkMsg);
  body.scrollTop = body.scrollHeight;
  const formData = {};
  formData['question'] = question;
  formData['language'] = language;
  fetch('https://remobu-app-production.up.railway.app/api/advisor', {
    method: 'POST',
    body: JSON.stringify(formData),
    headers: {'Content-Type': 'application/json'}
  })
  .then(r => r.json())
  .then(data => {
    const answer = data.answer || 'Sorry, could not get a response.';
    document.getElementById('remobu-thinking').remove();
    const msg = document.createElement('div');
    msg.className = 'remobu-message';
    const cleanAnswer = answer.replace(/\*\*/g,'').replace(/\*/g,'').replace(/\n/g,'<br>');
    msg.innerHTML = '<div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;"><img src="https://cdn.shopify.com/s/files/1/0975/4057/1438/files/Remobu_Logo.jpg?v=1778694454" style="width:22px;height:22px;border-radius:50%;object-fit:contain;background:white;padding:1px;border:1px solid #2D5233;"><strong style="color:#2D5233">Remobu Farm Advisor</strong></div>' + cleanAnswer;
    body.appendChild(msg);
    body.scrollTop = body.scrollHeight;
    document.getElementById('remobu-question').value = '';
    btn.disabled = false;
    btn.textContent = 'Ask';
  })
  .catch(() => {
    document.getElementById('remobu-thinking').textContent = '❌ Connection error. Please try again.';
    btn.disabled = false;
    btn.textContent = 'Ask';
  });
}
document.addEventListener('keydown', function(e) {
  if (e.key === 'Enter' && !e.shiftKey && document.activeElement.id === 'remobu-question') {
    e.preventDefault();
    remobAsk();
  }
});
</script>
<!-- End Remobu Floating Buttons -->